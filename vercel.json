{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "build": {
    "env": {
      "HUGO_VERSION": "0.165.0"
    }
  },
  "buildCommand": "hugo --source exampleSite --themesDir \"$(dirname \"$PWD\")\" --theme \"$(basename \"$PWD\")\" --destination public --cleanDestinationDir --gc --minify",
  "outputDirectory": "exampleSite/public"
}
